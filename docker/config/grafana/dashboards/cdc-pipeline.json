{
  "title": "CDC Pipeline",
  "uid": "cdc-pipeline",
  "tags": ["cdc"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Topics",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "redpanda_cluster_topics",
          "legendFormat": "topics"
        }
      ]
    },
    {
      "title": "Partitions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "redpanda_cluster_partitions",
          "legendFormat": "partitions"
        }
      ]
    },
    {
      "title": "Consumer Groups",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(redpanda_kafka_consumer_group_consumers)",
          "legendFormat": "groups"
        }
      ]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "redpanda_application_uptime_seconds_total",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "title": "Records Produced (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(redpanda_kafka_records_produced_total[1m]) * 60",
          "legendFormat": "records/min"
        }
      ]
    },
    {
      "title": "Records Fetched (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(redpanda_kafka_records_fetched_total[1m]) * 60",
          "legendFormat": "records/min"
        }
      ]
    },
    {
      "title": "Request Bytes (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "expr": "rate(redpanda_kafka_request_bytes_total[1m])",
          "legendFormat": "{{redpanda_cmd}}"
        }
      ]
    },
    {
      "title": "Request Latency p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(redpanda_kafka_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s"
}
